; Engine configuration file.
config_version=5

[application]

config/name="PiggyWorld"
config/description="Уютная пиксельная ферма про свинку"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
TimeSystem="*res://autoload/time_system.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.22, 0.48, 0.60, 1)
2d/snap/snap_2d_transforms_to_pixel=true
